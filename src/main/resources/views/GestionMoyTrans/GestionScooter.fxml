<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane minHeight="600" minWidth="800" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.gu.controller.GestionScooter">

    <children>
        <fx:include source="SideBar.fxml" />

        <!-- Titre -->
        <Text layoutX="152.0" layoutY="114.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Gestion des Scooters">
            <font>
                <Font size="25.0" />
            </font>
        </Text>

        <!-- Champs de saisie pour les informations du scooter -->
        <TextField fx:id="numeroScooterField" layoutX="174.0" layoutY="169.0" prefHeight="40.0" prefWidth="335.0" promptText="Numéro Scooter" />
        <TextField fx:id="localisationScooterField" layoutX="554.0" layoutY="169.0" prefHeight="40.0" prefWidth="335.0" promptText="Localisation Scooter" />

        <!-- Barre de recherche -->
        <TextField fx:id="searchField" layoutX="316.0" layoutY="300.0" onKeyReleased="#filterScooterList" prefHeight="30.0" prefWidth="625.0" promptText="Rechercher un scooter..." />

        <!-- Bouton d'ajout -->
        <Button fx:id="ajouterButton" layoutX="722.0" layoutY="232.0" mnemonicParsing="false" onAction="#ajouterScooter" prefHeight="37.0" prefWidth="170.0" text="Ajouter Scooter">
            <font>
                <Font size="16.0" />
            </font>
        </Button>

        <!-- Séparation -->
        <Line endX="581.3999633789062" layoutX="297.0" layoutY="290.0" startX="-122.80000305175781" stroke="#949494" />

        <!-- ListView affichant la liste des scooters -->
        <ListView fx:id="listViewScooter" layoutX="159.0" layoutY="350.0" prefHeight="266.0" prefWidth="788.0" />

        <!-- Labels pour les champs -->
        <Label layoutX="174.0" layoutY="142.0" text="Numéro Scooter">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
        <Label layoutX="553.0" layoutY="142.0" text="Localisation Scooter">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <!-- Label de recherche -->
        <Label layoutX="174.0" layoutY="302.0" text="Chercher Scooter">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
    </children>
</AnchorPane>
