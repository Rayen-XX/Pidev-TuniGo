<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane minWidth="800" minHeight="600" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.gu.controller.GestionReclamation">

    <children>
        <!-- Titre -->
        <Text layoutX="350.0" layoutY="40.0" text="Gestion des Réclamations">
            <font>
                <Font size="25.0" />
            </font>
        </Text>

        <!-- Barre de recherche -->
        <Text layoutX="86.0" layoutY="90.0" text="Rechercher :">
            <font>
                <Font size="14.0" />
            </font>
        </Text>

        <TextField fx:id="searchField" layoutX="170.0" layoutY="75.0" prefHeight="26.0" prefWidth="571.0" promptText="Nom utilisateur ou type" />

        <!-- Bouton de tri -->
        <Text layoutX="760.0" layoutY="93.0" text="Trier par :">
            <font>
                <Font size="14.0" />
            </font>
        </Text>

        <ComboBox fx:id="sortComboBox" layoutX="834.0" layoutY="75.0" prefHeight="26.0" prefWidth="76.0">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Date Croissante" />
                    <String fx:value="Date Décroissante" />
                    <String fx:value="En Attente" />
                    <String fx:value="Résolue" />

                </FXCollections>
            </items>
        </ComboBox>

        <!-- TableView prenant l'espace restant après le titre -->
        <ListView fx:id="listViewReclamation" layoutX="86.0" layoutY="123.0" prefHeight="416.0" prefWidth="828.0" />

        <Button fx:id="routourButton" layoutX="911.0" layoutY="34.0" mnemonicParsing="false" onAction="#routourButton" prefHeight="30.0" prefWidth="120" style="-fx-background-color: #B22222; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 5 20;" text="Retour">
        </Button>

        <fx:include source="reclampercent.fxml" layoutX="920.0" layoutY="123.0"/>

    </children>
</AnchorPane>
