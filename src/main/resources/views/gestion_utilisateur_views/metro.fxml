<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.gu.controller.gestion_utilisateur_controllers.MetroController"
            minWidth="800" minHeight="600"
            stylesheets="/styles/transport_styles.css">
    <children>
        <BorderPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <top>
                <VBox>
                    <!-- Header with logo and welcome message -->
                    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="header">
                        <padding>
                            <Insets left="20" right="20"/>
                        </padding>
                        <Label text="TuniGo" styleClass="header-label"/>
                        <HBox HBox.hgrow="ALWAYS"/>
                        <Label fx:id="welcomeLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Hyperlink fx:id="logoutLink" text="Déconnecter" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    </HBox>
                    
                    <!-- Navigation title -->
                    <HBox alignment="CENTER" style="-fx-padding: 20 0 10 0;">
                        <Label text="Métro" styleClass="transport-section-title"/>
                    </HBox>
                </VBox>
            </top>
            
            <center>
                <!-- Empty middle section -->
                <VBox alignment="CENTER" spacing="30" styleClass="transport-section">
                    <!-- This section is intentionally left empty -->
                </VBox>
            </center>
            
            <bottom>
                <HBox alignment="CENTER" spacing="10" style="-fx-padding: 20;">
                    <Button text="Retour" styleClass="return-button" onAction="#retourTransportPublic"/>
                </HBox>
            </bottom>
        </BorderPane>
    </children>
</AnchorPane> 