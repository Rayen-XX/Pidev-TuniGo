<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import java.lang.String?>
<AnchorPane minHeight="600" minWidth="800"
            xmlns="http://javafx.com/javafx/17.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.gu.controller.gestion_utilisateur_controllers.RegisterController"
            stylesheets="@../../css/auth_forms.css">
    <children>
        <!-- Split the screen horizontally into two equal parts -->
        <HBox prefHeight="600" prefWidth="800" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <!-- Left side: Registration Form -->
            <VBox alignment="CENTER" prefWidth="400" spacing="10"
                  styleClass="auth-container" HBox.hgrow="ALWAYS">
                <children>
                    <!-- Header Label -->
                    <Label text="S'inscrire" styleClass="auth-title" />

                    <!-- Personal information fields -->
                    <TextField fx:id="nomField" promptText="Nom" 
                              styleClass="auth-input" />

                    <TextField fx:id="prenomField" promptText="Prénom"
                              styleClass="auth-input" />

                    <TextField fx:id="emailField" promptText="E-mail"
                              styleClass="auth-input" />

                    <TextField fx:id="telephoneField" promptText="Numéro de téléphone"
                              styleClass="auth-input" />

                    <!-- Password Field with toggle -->
                    <StackPane maxWidth="300">
                        <PasswordField fx:id="motdepasseField" promptText="Mot de passe"
                                      styleClass="auth-input, auth-password" />
                        <TextField fx:id="motdepasseVisibleField" promptText="Mot de passe"
                                  styleClass="auth-input, auth-password"
                                  visible="false" managed="false" />
                        <Button fx:id="togglePasswordButton" onAction="#togglePasswordVisibility"
                               text="👁" styleClass="eye-button"
                               StackPane.alignment="CENTER_RIGHT" />
                    </StackPane>

                    <!-- Confirm Password Field with toggle -->
                    <StackPane maxWidth="300">
                        <PasswordField fx:id="confirmPasswordField" promptText="Confirmer votre mot de passe"
                                      styleClass="auth-input, auth-password" />
                        <TextField fx:id="confirmPasswordVisibleField" promptText="Confirmer votre mot de passe"
                                  styleClass="auth-input, auth-password"
                                  visible="false" managed="false" />
                        <Button fx:id="toggleConfirmPasswordButton" onAction="#toggleConfirmPasswordVisibility"
                               text="👁" styleClass="eye-button"
                               StackPane.alignment="CENTER_RIGHT" />
                    </StackPane>

                    <!-- Security Question Selection -->
                    <ChoiceBox fx:id="securityQuestionChoiceBox" styleClass="auth-choice-box" value="Quel est le nom de jeune fille de votre mère ?">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Quel est le nom de jeune fille de votre mère ?" />
                                <String fx:value="Quel est le nom de votre premier animal de compagnie ?" />
                                <String fx:value="Quel est le nom de votre école primaire ?" />
                            </FXCollections>
                        </items>
                    </ChoiceBox>

                    <!-- Security Answer Input -->
                    <TextField fx:id="securityAnswerField" promptText="Réponse de sécurité"
                              styleClass="auth-input" />

                    <!-- Global error label -->
                    <Label fx:id="globalErrorLabel" styleClass="error-label" visible="false" />

                    <!-- Register button -->
                    <Button onAction="#handleRegister" text="s'inscrire" 
                           styleClass="auth-button" />

                    <!-- Login link -->
                    <Hyperlink onAction="#goToLogin" text="Vous avez déjà un compte ? Connectez-vous" 
                              styleClass="auth-link" />
                </children>
            </VBox>

            <!-- Right side: Full-height background image -->
            <AnchorPane prefWidth="400" style="-fx-background-size: cover; -fx-background-position: center;" HBox.hgrow="ALWAYS">
                <children>
                    <ImageView fitHeight="600.0" fitWidth="400.0">
                        <image>
                            <Image url="@../../Images/gestion_utilisateur_images/signup.png" />
                        </image>
                    </ImageView>
                </children>
            </AnchorPane>
        </HBox>
    </children>
</AnchorPane>
