<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import java.lang.String?>
<AnchorPane minHeight="600" minWidth="800"
            xmlns="http://javafx.com/javafx/17.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.gu.controller.gestion_utilisateur_controllers.RegisterController">
    <children>
        <!-- Split the screen horizontally into two equal parts -->
        <HBox prefHeight="600" prefWidth="800" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <!-- Left side: Registration Form -->
            <VBox alignment="CENTER" prefWidth="400" spacing="10"
                  style="-fx-background-color: white; -fx-padding: 40;" HBox.hgrow="ALWAYS">
                <children>
                    <!-- Header Label with custom font family; change -fx-font-family here if needed -->
                    <Label text="S'inscrire" style="-fx-font-family: 'Montserrat'; -fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #B22222;" />

                    <!-- Reduced height for inputs: padding reduced to 5 and pref-height set to 30 -->
                    <TextField fx:id="nomField" maxWidth="300" promptText="Nom"
                               style="-fx-background-color: #f5f5f5; -fx-border-color: #565656; -fx-border-width: 1; -fx-border-radius: 5; -fx-font-size: 16px; -fx-text-fill: #333; -fx-padding: 5; -fx-pref-height: 30;" />

                    <TextField fx:id="prenomField" maxWidth="300" promptText="Prénom"
                               style="-fx-background-color: #f5f5f5; -fx-border-color: #565656; -fx-border-width: 1; -fx-border-radius: 5; -fx-font-size: 16px; -fx-text-fill: #333; -fx-padding: 5; -fx-pref-height: 30;" />

                    <TextField fx:id="emailField" maxWidth="300" promptText="E-mail"
                               style="-fx-background-color: #f5f5f5; -fx-border-color: #565656; -fx-border-width: 1; -fx-border-radius: 5; -fx-font-size: 16px; -fx-text-fill: #333; -fx-padding: 5; -fx-pref-height: 30;" />

                    <TextField fx:id="telephoneField" maxWidth="300" promptText="Numéro de téléphone"
                               style="-fx-background-color: #f5f5f5; -fx-border-color: #565656; -fx-border-width: 1; -fx-border-radius: 5; -fx-font-size: 16px; -fx-text-fill: #333; -fx-padding: 5; -fx-pref-height: 30;" />

                    <!-- Password Field with toggle -->
                    <StackPane maxWidth="300">
                        <PasswordField fx:id="motdepasseField" promptText="Mot de passe"
                                       style="-fx-background-color: #f5f5f5; -fx-border-color: #565656; -fx-border-width: 1; -fx-border-radius: 5; -fx-font-size: 16px; -fx-text-fill: #333; -fx-padding: 5 40 5 10; -fx-pref-height: 30;" />
                        <TextField fx:id="motdepasseVisibleField" managed="false" promptText="Mot de passe"
                                   style="-fx-background-color: #f5f5f5; -fx-border-color: #565656; -fx-border-width: 1; -fx-border-radius: 5; -fx-font-size: 16px; -fx-text-fill: #333; -fx-padding: 5 40 5 10; -fx-pref-height: 30;" visible="false" />
                        <Button fx:id="togglePasswordButton" onAction="#togglePasswordVisibility"
                                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 10 0 0;" text="👁"
                                StackPane.alignment="CENTER_RIGHT" />
                    </StackPane>

                    <!-- Confirm Password Field with toggle -->
                    <StackPane maxWidth="300">
                        <PasswordField fx:id="confirmPasswordField" promptText="Confirmer votre mot de passe"
                                       style="-fx-background-color: #f5f5f5; -fx-border-color: #565656; -fx-border-width: 1; -fx-border-radius: 5; -fx-font-size: 16px; -fx-text-fill: #333; -fx-padding: 5 40 5 10; -fx-pref-height: 30;" />
                        <TextField fx:id="confirmPasswordVisibleField" managed="false" promptText="Confirmer votre mot de passe"
                                   style="-fx-background-color: #f5f5f5; -fx-border-color: #B22222; -fx-border-width: 1; -fx-border-radius: 5; -fx-font-size: 16px; -fx-text-fill: #333; -fx-padding: 5 40 5 10; -fx-pref-height: 30;" visible="false" />
                        <Button fx:id="toggleConfirmPasswordButton" onAction="#toggleConfirmPasswordVisibility"
                                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 10 0 0;" text="👁"
                                StackPane.alignment="CENTER_RIGHT" />
                    </StackPane>

                    <!-- Security Question Selection - simplified styling as controller will handle it -->
                    <ChoiceBox fx:id="securityQuestionChoiceBox" maxWidth="300" value="Quel est le nom de jeune fille de votre mère ?">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Quel est le nom de jeune fille de votre mère ?" />
                                <String fx:value="Quel est le nom de votre premier animal de compagnie ?" />
                                <String fx:value="Quel est le nom de votre école primaire ?" />
                            </FXCollections>
                        </items>
                    </ChoiceBox>

                    <!-- Security Answer Input -->
                    <TextField fx:id="securityAnswerField" maxWidth="300" promptText="Réponse de sécurité"
                               style="-fx-background-color: #f5f5f5; -fx-border-color: #565656; -fx-border-width: 1; -fx-border-radius: 5; -fx-font-size: 16px; -fx-text-fill: #333; -fx-padding: 5; -fx-pref-height: 30;" />

                    <!-- Global error label: same width as inputs -->
                    <Label fx:id="globalErrorLabel" maxWidth="300" style="-fx-font-size: 14px;" textFill="red" visible="false" />

                    <Button onAction="#handleRegister" style="-fx-background-color: #B22222; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 5 20;" text="s'inscrire" />

                    <Hyperlink onAction="#goToLogin" style="-fx-text-fill: #565656; -fx-font-size: 14px;" text="Vous avez déjà un compte ? Connectez-vous" />
                </children>
            </VBox>

            <!-- Right side: Full-height background image -->
            <AnchorPane prefWidth="400" style="-fx-background-size: cover; -fx-background-position: center;" HBox.hgrow="ALWAYS">
                <children>
                    <ImageView fitHeight="600.0" fitWidth="400.0">
                        <image>
                            <Image url="@../../Images/gestion_utilisateur_images/signup.png" />
                        </image>
                    </ImageView>
                </children>
            </AnchorPane>
        </HBox>
    </children>
</AnchorPane>
