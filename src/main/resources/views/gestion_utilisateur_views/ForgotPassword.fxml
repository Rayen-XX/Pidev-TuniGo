<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="600" minWidth="800"
            xmlns="http://javafx.com/javafx/17.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.gu.controller.gestion_utilisateur_controllers.ForgotPasswordController">
    <children>
        <HBox prefHeight="600" prefWidth="800" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <!-- Left side: Forgot Password Form -->
            <VBox alignment="CENTER" spacing="10" prefWidth="400"
                  style="-fx-background-color: white; -fx-padding: 40;" HBox.hgrow="ALWAYS">
                <children>
                    <!-- Header -->
                    <Label text="Réinitialiser le mot de passe"
                           style="-fx-font-family: 'Montserrat'; -fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #B22222;" />

                    <!-- Email Search Section -->
                    <VBox fx:id="emailSearchSection" spacing="10">
                        <TextField fx:id="fpEmailField" promptText="Votre adresse e-mail" maxWidth="300"
                                   style="-fx-background-color: #f5f5f5; -fx-border-color: #565656; -fx-border-width: 1; -fx-border-radius: 5; -fx-font-size: 16px; -fx-padding: 5; -fx-pref-height: 30;" />
                        <Button text="Rechercher" onAction="#handleEmailSearch"
                                style="-fx-background-color: #B22222; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 5 20;" />
                    </VBox>

                    <!-- Reset Section: Initially hidden -->
                    <VBox fx:id="resetSection" spacing="10" visible="false" managed="false">
                        <!-- Display the stored security question -->
                        <Label fx:id="securityQuestionLabel" text="Votre question de sécurité"
                               style="-fx-font-size: 16px; -fx-text-fill: #333;" />
                        <!-- Input for security answer -->
                        <TextField fx:id="securityAnswerField" promptText="Votre réponse" maxWidth="300"
                                   style="-fx-background-color: #f5f5f5; -fx-border-color: #565656; -fx-border-width: 1; -fx-border-radius: 5; -fx-font-size: 16px; -fx-padding: 5; -fx-pref-height: 30;" />
                        <!-- New Password Field with Toggle -->
                        <StackPane maxWidth="300">
                            <PasswordField fx:id="newPasswordField" promptText="Nouveau mot de passe"
                                           style="-fx-background-color: #f5f5f5; -fx-border-color: #565656; -fx-border-width: 1; -fx-border-radius: 5; -fx-font-size: 16px; -fx-padding: 5 40 5 10; -fx-pref-height: 30;" />
                            <TextField fx:id="newPasswordVisibleField" promptText="Nouveau mot de passe"
                                       style="-fx-background-color: #f5f5f5; -fx-border-color: #565656; -fx-border-width: 1; -fx-border-radius: 5; -fx-font-size: 16px; -fx-padding: 5 40 5 10; -fx-pref-height: 30;"
                                       visible="false" managed="false" />
                            <Button fx:id="toggleNewPasswordButton" text="👁" onAction="#toggleNewPasswordVisibility"
                                    style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 10 0 0;"
                                    StackPane.alignment="CENTER_RIGHT"/>
                        </StackPane>

                        <!-- Confirm New Password Field with Toggle -->
                        <StackPane maxWidth="300">
                            <PasswordField fx:id="confirmNewPasswordField" promptText="Confirmer le nouveau mot de passe"
                                           style="-fx-background-color: #f5f5f5; -fx-border-color: #565656; -fx-border-width: 1; -fx-border-radius: 5; -fx-font-size: 16px; -fx-padding: 5 40 5 10; -fx-pref-height: 30;" />
                            <TextField fx:id="confirmNewPasswordVisibleField" promptText="Confirmer le nouveau mot de passe"
                                       style="-fx-background-color: #f5f5f5; -fx-border-color: #565656; -fx-border-width: 1; -fx-border-radius: 5; -fx-font-size: 16px; -fx-padding: 5 40 5 10; -fx-pref-height: 30;"
                                       visible="false" managed="false" />
                            <Button fx:id="toggleConfirmNewPasswordButton" text="👁" onAction="#toggleConfirmNewPasswordVisibility"
                                    style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 10 0 0;"
                                    StackPane.alignment="CENTER_RIGHT"/>
                        </StackPane>

                        <Button text="Réinitialiser" onAction="#handleResetPassword"
                                style="-fx-background-color: #B22222; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 5 20;" />
                    </VBox>

                    <!-- Global error label for forgot password validation -->
                    <Label fx:id="fpErrorLabel" maxWidth="300" textFill="red" visible="false" style="-fx-font-size: 14px;" />

                    <Hyperlink text="Retour" onAction="#goToLogin" style="-fx-text-fill: #565656; -fx-font-size: 14px;" />
                </children>
            </VBox>

            <!-- Right side: Background image -->
            <AnchorPane prefWidth="400" style="-fx-background-size: cover; -fx-background-position: center;" HBox.hgrow="ALWAYS">
                <children>
                    <ImageView fitHeight="600.0" fitWidth="400.0">
                        <image>
                            <Image url="@../../Images/gestion_utilisateur_images/signup.png" />
                        </image>
                    </ImageView>
                </children>
            </AnchorPane>
        </HBox>
    </children>
</AnchorPane>
