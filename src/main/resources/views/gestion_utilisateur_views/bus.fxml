<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.gu.controller.gestion_utilisateur_controllers.BusController"
            minWidth="800" minHeight="600"
            stylesheets="/styles/transport_styles.css">
    <children>
        <BorderPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <top>
                <VBox>
                    <!-- Header with logo and welcome message -->
                    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="header">
                        <padding>
                            <Insets left="20" right="20"/>
                        </padding>
                        <!-- Temporarily commenting out the logo image -->
                        <!--
                        <ImageView fitHeight="50" fitWidth="50" preserveRatio="true">
                            <Image url="/images/logo.png"/>
                        </ImageView>
                        -->
                        <Label text="TuniGo" styleClass="header-label"/>
                        <HBox HBox.hgrow="ALWAYS"/>
                        <Label fx:id="welcomeLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Hyperlink fx:id="logoutLink" text="Déconnecter" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    </HBox>
                    
                    <!-- Navigation title -->
                    <HBox alignment="CENTER" style="-fx-padding: 20 0 10 0;">
                        <Label text="Bus" styleClass="transport-section-title"/>
                    </HBox>
                </VBox>
            </top>
            
            <center>
                <VBox alignment="CENTER" spacing="30" styleClass="transport-section">
                    <VBox maxWidth="600" spacing="15" styleClass="form-container">
                        <Label text="Réserver votre trajet en bus" styleClass="form-title"/>
                        
                        <HBox spacing="20">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Ville de départ" styleClass="form-label"/>
                                <ComboBox fx:id="departComboBox" promptText="Sélectionner une ville" maxWidth="Infinity"/>
                            </VBox>
                            
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Ville d'arrivée" styleClass="form-label"/>
                                <ComboBox fx:id="arriveeComboBox" promptText="Sélectionner une ville" maxWidth="Infinity"/>
                            </VBox>
                        </HBox>
                        
                        <HBox spacing="20">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Date de départ" styleClass="form-label"/>
                                <DatePicker fx:id="dateDepartPicker" promptText="Sélectionner une date" maxWidth="Infinity"/>
                            </VBox>
                            
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Nombre de passagers" styleClass="form-label"/>
                                <TextField fx:id="passagersTextField" promptText="Ex: 2" maxWidth="Infinity"/>
                            </VBox>
                        </HBox>
                        
                        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20 0 0 0;">
                            <Button text="Vérifier disponibilité" styleClass="primary-button" onAction="#verifierDisponibilite"/>
                            <Button text="Réserver" styleClass="primary-button" onAction="#reserverBus"/>
                        </HBox>
                    </VBox>
                </VBox>
            </center>
            
            <bottom>
                <HBox alignment="CENTER" spacing="10" style="-fx-padding: 20;">
                    <Button text="Retour" styleClass="return-button" onAction="#retourTransportPublic"/>
                </HBox>
            </bottom>
        </BorderPane>
    </children>
</AnchorPane> 