<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.gu.controller.gestion_utilisateur_controllers.UpdateProfileController"
            prefHeight="500.0" prefWidth="500.0">
    <children>
        <VBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-padding: 30;"
              AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <Label text="Modifier votre profil"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #B22222;"/>
                
                <!-- Personal Information Section -->
                <Label text="Informations personnelles" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                
                <HBox spacing="10">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Nom"/>
                        <TextField fx:id="nomField" promptText="Nom"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Prénom"/>
                        <TextField fx:id="prenomField" promptText="Prénom"/>
                    </VBox>
                </HBox>
                
                <VBox spacing="5">
                    <Label text="Email"/>
                    <TextField fx:id="emailField" promptText="Email"/>
                </VBox>
                
                <VBox spacing="5">
                    <Label text="Numéro de téléphone"/>
                    <TextField fx:id="numeroField" promptText="Numéro de téléphone"/>
                </VBox>
                
                <!-- Password Section -->
                <Label text="Sécurité" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Mot de passe"/>
                        <PasswordField fx:id="motdepasseField" promptText="Mot de passe"/>
                        <TextField fx:id="motdepasseVisibleField" promptText="Mot de passe" visible="false" managed="false"/>
                    </VBox>
                    <ToggleButton fx:id="togglePasswordButton" onAction="#togglePasswordVisibility" text="Afficher" prefHeight="30"/>
                </HBox>
                
                <HBox spacing="10">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Question de sécurité"/>
                        <ComboBox fx:id="securityQuestionComboBox" promptText="Choisir une question" maxWidth="Infinity"/>
                    </VBox>
                </HBox>
                
                <VBox spacing="5">
                    <Label text="Réponse à la question de sécurité"/>
                    <TextField fx:id="securityAnswerField" promptText="Réponse"/>
                </VBox>
                
                <!-- Error display -->
                <Label fx:id="globalErrorLabel" style="-fx-text-fill: red; -fx-font-weight: bold;" visible="false"/>
                
                <!-- Buttons Section -->
                <HBox spacing="15" alignment="CENTER">
                    <padding>
                        <Insets top="15"/>
                    </padding>
                    <Button fx:id="updateButton" text="Mettre à jour" onAction="#handleUpdate"
                            style="-fx-background-color: #B22222; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 8 25;"/>
                    <Button text="Annuler" onAction="#handleCancel"
                            style="-fx-background-color: #6c757d; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 8 25;"/>
                </HBox>
                
                <!-- Delete Account Button -->
                <HBox alignment="CENTER" spacing="15">
                    <padding>
                        <Insets top="10"/>
                    </padding>
                    <Button fx:id="deleteAccountButton" text="Supprimer mon compte" onAction="#handleDeleteAccount"
                            style="-fx-background-color: #dc3545; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 8 25;"/>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
