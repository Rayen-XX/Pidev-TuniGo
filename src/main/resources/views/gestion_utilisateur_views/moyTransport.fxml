<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.gu.controller.gestion_utilisateur_controllers.MoyTransportController"
            minWidth="800" minHeight="600"
            stylesheets="/styles/transport_styles.css">
    <children>
        <BorderPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <top>
                <VBox>
                    <!-- Header with logo and welcome message -->
                    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="header">
                        <padding>
                            <Insets left="20" right="20"/>
                        </padding>
                        <!-- Temporarily commenting out the logo image 
                        <ImageView fitHeight="50" fitWidth="50" preserveRatio="true">
                            <Image url="/images/logo.png"/>
                        </ImageView>
                        -->
                        <Label text="TuniGo" styleClass="header-label"/>
                        <HBox HBox.hgrow="ALWAYS"/>
                        <Label fx:id="welcomeLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Hyperlink fx:id="logoutLink" text="Déconnecter" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    </HBox>
                    
                    <!-- Navigation title -->
                    <HBox alignment="CENTER" style="-fx-padding: 20 0 10 0;">
                        <Label text="Choisissez votre mode de transport" styleClass="transport-section-title"/>
                    </HBox>
                </VBox>
            </top>
            
            <center>
                <VBox alignment="CENTER" spacing="30" styleClass="transport-section">
                    <HBox alignment="CENTER" spacing="50">
                        <!-- Transport Public Card -->
                        <VBox styleClass="transport-card" onMouseClicked="#navigateToTransportPublic" alignment="CENTER">
                           
                            <VBox styleClass="transport-image-container" alignment="CENTER">
                                <ImageView fitHeight="180" fitWidth="280" preserveRatio="false">
                                    <Image url="@../../Images/gestion_utilisateur_images/transportPublic.jpg"/>
                                </ImageView>
                            </VBox>
                           
                            <Label text="Transport Public" styleClass="transport-card-title" alignment="CENTER"/>
                            <Label text="Bus, métro, train et autres moyens de transport public." styleClass="transport-card-description" alignment="CENTER" textAlignment="CENTER"/>
                            <Button text="Choisir" styleClass="card-button" onAction="#navigateToTransportPublic"/>
                        </VBox>
                        
                        <!-- Transport Privé Card -->
                        <VBox styleClass="transport-card" onMouseClicked="#navigateToTransportPrive" alignment="CENTER">
                           
                            <VBox styleClass="transport-image-container" alignment="CENTER">
                                <ImageView fitHeight="180" fitWidth="280" preserveRatio="false">
                                    <Image url="@../../Images/gestion_utilisateur_images/transportPrivé.jpeg"/>
                                </ImageView>
                            </VBox>
                            
                            <Label text="Transport Privé" styleClass="transport-card-title" alignment="CENTER"/>
                            <Label text="Taxis, scooters et autres options de transport privé." styleClass="transport-card-description" alignment="CENTER" textAlignment="CENTER"/>
                            <Button text="Choisir" styleClass="card-button" onAction="#navigateToTransportPrive"/>
                        </VBox>
                    </HBox>
                </VBox>
            </center>
            
            <bottom>
                <HBox alignment="CENTER" spacing="10" style="-fx-padding: 20;">
                    <Button text="Retour" styleClass="return-button" onAction="#retourProfile"/>
                </HBox>
            </bottom>
        </BorderPane>
    </children>
</AnchorPane> 